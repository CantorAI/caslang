{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CantorAI/caslang/corpus/schema/record.schema.json",
  "title": "CasLang corpus record",
  "type": "object",
  "required": ["id", "task", "spec_version", "profile", "request", "capabilities", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "task": {"enum": ["generate", "repair"]},
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "profile": {"type": "string"},
    "request": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "script": {"type": "string"},
    "invalid_script": {"type": "string"},
    "expected_error": {"type": "string", "pattern": "^E[123][0-9]{3}$"},
    "corrected_script": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance": {
      "type": "object",
      "required": ["kind", "license"],
      "properties": {
        "kind": {"enum": ["handwritten", "synthetic", "public"]},
        "license": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"task": {"const": "generate"}}}, "then": {"required": ["script"]}},
    {"if": {"properties": {"task": {"const": "repair"}}}, "then": {"required": ["invalid_script", "expected_error", "corrected_script"]}}
  ],
  "additionalProperties": false
}
